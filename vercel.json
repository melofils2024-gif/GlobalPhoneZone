{
  "version": 2,
  "builds": [
    {
      "src": "Accueil-phone.html",
      "use": "@vercel/static"
    },
    {
      "src": "CSS/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/Accueil-phone.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
